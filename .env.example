# Copy to .env.local for development; set the same keys in Vercel for production.

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (Gemini required; the rest are fallbacks) ----------------
# https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://build.nvidia.com
NVIDIA_NIM_API_KEY=
# Optional — stronger free coding models. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Images ----------------------------------------------------------------
# Generated pictures for every site: Cloudflare Workers AI, FLUX.1 [schnell]
# (Apache-2.0 — no credit line needed). Free allocation ≈ 170 images a day.
# Account ID: Cloudflare dashboard → Workers AI.
# Token: My Profile → API Tokens → Create Token → "Workers AI" template.
# Images are stored in a public Supabase Storage bucket "site-images", created
# on first use with SUPABASE_SERVICE_ROLE_KEY. Without these, pictures are
# drawn in code in the site's palette.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Our Cloudflare account pays for these: a production build makes them only
# when this is "true" (hosted visitors bring their own keys — see BACKLOG).
IMAGE_GENERATION_HOSTED=

# Optional, only with NEXT_PUBLIC_IMAGE_SOURCE=photos (the old stock-photo path).
PEXELS_API_KEY=

# --- App -------------------------------------------------------------------
# Public base URL, e.g. https://intentdraw.app (used for OpenRouter attribution)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=IntentDraw

# Daily generations per user in production (development is uncapped).
RATE_LIMIT_MAX_GENERATIONS=10

# Development only: set to "false" to test the real sign-in flow locally.
# Ignored in production builds — sign-in is always required there.
NEXT_PUBLIC_AUTH_BYPASS=
